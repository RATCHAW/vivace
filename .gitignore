*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore
*credentials*.json
*service-account*.json
*.tfstate
*.tfstate.*
*.sqlite
*.sqlite3
*.db

# Tool and workspace state
.context/
.vercel/
.wrangler/
.netlify/
.DS_Store

# Scratch output of `pnpm --filter @repo/api auth:generate` — read, never applied.
apps/api/.better-auth-schema.ts
