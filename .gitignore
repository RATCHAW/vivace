# Dependencies and generated output
node_modules/
dist/
.next/
# Regenerated by `next typegen`; it references files inside .next/
next-env.d.ts
.turbo/
*.tsbuildinfo

# Local secrets. Keep deliberately redacted examples under version control.
.env
.env.*
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example
*.local
.envrc
.direnv/
.dev.vars
.npmrc

