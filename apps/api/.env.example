# Postgres (matches docker-compose.yml `db` service)
DATABASE_URL=postgres://app:app@localhost:5433/app

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Where this API is reachable (OAuth callbacks are built from this)
BETTER_AUTH_URL=http://localhost:3000

# The web app origin (CORS + trusted origin)
WEB_ORIGIN=http://localhost:5173

# --- Logging (Grafana Loki) ---------------------------------------------------
# Logs always go to stdout as JSON. Set LOKI_URL to also push them to Loki,
# which is what the Grafana dashboards in ops/grafana read.
#   local:         docker compose --profile observability up -d
#                  LOKI_URL=http://localhost:3100  (Grafana on :3002)
#   Grafana Cloud: LOKI_URL=https://logs-prod-xxx.grafana.net
#                  plus the user id / API token below
LOKI_URL=
LOKI_USERNAME=
LOKI_PASSWORD=
# trace | debug | info | warn | error — defaults to info
LOG_LEVEL=
# Labels the logs in Loki, so staging and production don't share a stream —
# and rides along on every PostHog event as `environment`, which is what keeps
# the athletes you test with locally out of production's numbers
APP_ENV=development
# Force human-readable logs (true) or JSON (false); defaults to a TTY check
LOG_PRETTY=

# --- PostHog (product analytics, error tracking, feature flags, LLM traces) ---
# Unset and the API behaves identically, minus the reporting. Get the project
# API key from PostHog → Settings → Project. Server-side keys are write-only.
POSTHOG_KEY=
# Your project's region — https://eu.i.posthog.com for EU, or a self-hosted URL
POSTHOG_HOST=https://us.i.posthog.com
# Send the coach's prompts and replies with its LLM traces. Off by default: the
# tokens, cost, latency and errors arrive either way, and a training
# conversation isn't something to ship to a third party without deciding to.
POSTHOG_LLM_CAPTURE_CONTENT=

# From https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Strava webhook (optional) ------------------------------------------------
# Turns a finished run into a post-run debrief without anyone asking. The verify
# token is any random string; the running API echoes Strava's challenge only
# when it matches.
#   openssl rand -hex 16
# Then, with the API publicly reachable (a tunnel is fine in development):
#   pnpm --filter @repo/api webhook subscribe https://<host>/api/strava/webhook
#   pnpm --filter @repo/api webhook view
#   pnpm --filter @repo/api webhook delete <id>
# Strava allows one subscription per application. Unset, the callback refuses to
# validate and nothing else changes.
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Copy the signing secret assigned to the Strava application. Every POST fails
# closed unless its X-Strava-Signature HMAC is valid and no more than 5m old.
STRAVA_WEBHOOK_SIGNING_SECRET=

# --- AI coach (optional) ------------------------------------------------------
# Every model is reached through LLM Gateway, which speaks the AI SDK's own
# gateway protocol. Without this key, /coach loads but every message comes back
# 503; everything else works. Get one from https://llmgateway.io
LLM_GATEWAY_API_KEY=
# Any model the gateway routes, written vendor/model so the vendor is pinned —
# defaults to deepseek/deepseek-v4-flash. The `coach-model` PostHog flag
# overrides this per athlete; this is the pairing everyone gets without one.
COACH_MODEL=deepseek/deepseek-v4-flash
# Which system prompt goes with it: v1 or v2-terse (see SYSTEM_PROMPTS in
# apps/api/src/coach.ts). Defaults to v1. A prompt tuned for one model is not
# the prompt for another, which is why the two move together.
COACH_PROMPT=v1
# Only for a self-hosted gateway. The path carries the AI SDK major it answers
# for: /v4/ai is AI SDK 7. Defaults to https://api.llmgateway.io/v4/ai.
LLM_GATEWAY_URL=

# --- Remotion Lambda video rendering (optional) -------------------------------
# Without these, the render button returns 503; everything else works.
# AWS IAM user credentials — set up per https://www.remotion.dev/docs/lambda/setup
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
# Then deploy the functions + site: pnpm video:deploy
# (it prints the three values below, plus any override it created)
REMOTION_AWS_REGION=us-east-1
# The shared function, and the bundle holding every template's composition.
# One site is the normal state — templates are compositions in it, not
# deployments of their own, so adding one costs nothing here.
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
# Optional overrides, both looked up before the shared values above:
#   REMOTION_FUNCTION_NAME_<PROFILE>  a cheaper (or bigger) function for one
#     class of template — see RENDER_PROFILES in packages/video/src/registry.ts
#   REMOTION_SERVE_URL_<TEMPLATE>     a bundle of its own for one template, to
#     canary it or to keep heavy dependencies out of everyone else's cold start
# Server-side Mapbox token baked into rendered videos (the browser uses
# VITE_MAPBOX_TOKEN separately). Empty renders the plain route canvas.
MAPBOX_TOKEN=
