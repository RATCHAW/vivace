# Postgres (matches docker-compose.yml `db` service)
DATABASE_URL=postgres://app:app@localhost:5433/app

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Where this API is reachable (OAuth callbacks are built from this)
BETTER_AUTH_URL=http://localhost:3000

# The web app origin (CORS + trusted origin)
WEB_ORIGIN=http://localhost:5173

# From https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to: localhost
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- Remotion Lambda video rendering (optional) -------------------------------
# Without these, the render button returns 503; everything else works.
# AWS IAM user credentials — set up per https://www.remotion.dev/docs/lambda/setup
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
# Then deploy the function + site: pnpm --filter @repo/web remotion:deploy
# (it prints the three values below)
REMOTION_AWS_REGION=us-east-1
REMOTION_FUNCTION_NAME=
REMOTION_SERVE_URL=
# Server-side Mapbox token baked into rendered videos (the browser uses
# VITE_MAPBOX_TOKEN separately). Empty renders the plain route canvas.
MAPBOX_TOKEN=
