{
  "openapi": "3.1.0",
  "info": {
    "title": "Strava Login App API",
    "version": "0.0.0",
    "description": "Sign in with Strava, then read your profile. Requests are authenticated with the better-auth session cookie, so 'Try it out' works from a browser that is already signed in. The auth endpoints themselves (/api/auth/*) are documented separately at /api/auth/reference."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin"
    }
  ],
  "tags": [
    {
      "name": "Meta",
      "description": "Liveness and documentation"
    },
    {
      "name": "Athlete",
      "description": "The signed-in athlete's Strava profile"
    },
    {
      "name": "Runs",
      "description": "The signed-in athlete's runs and their streams"
    },
    {
      "name": "Coach",
      "description": "Conversations with the AI running coach"
    },
    {
      "name": "Telemetry",
      "description": "Browser events and errors, forwarded to Loki"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token",
        "description": "Set by better-auth after the Strava OAuth callback."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "Athlete": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1234567
          },
          "username": {
            "type": [
              "string",
              "null"
            ],
            "example": "marianne_t"
          },
          "firstname": {
            "type": "string",
            "example": "Marianne"
          },
          "lastname": {
            "type": "string",
            "example": "Teutenberg"
          },
          "bio": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ],
            "example": "San Francisco"
          },
          "state": {
            "type": [
              "string",
              "null"
            ],
            "example": "CA"
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "example": "US"
          },
          "sex": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "M",
              "F",
              null
            ]
          },
          "premium": {
            "type": "boolean"
          },
          "summit": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2017-11-14T02:30:05Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "profile": {
            "type": "string"
          },
          "profile_medium": {
            "type": "string"
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "username",
          "firstname",
          "lastname",
          "bio",
          "city",
          "state",
          "country",
          "sex",
          "premium",
          "summit",
          "created_at",
          "updated_at",
          "profile",
          "profile_medium",
          "weight"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Not signed in"
          }
        },
        "required": [
          "error"
        ]
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 987654321
          },
          "name": {
            "type": "string",
            "example": "Morning Run"
          },
          "distance": {
            "type": "number",
            "example": 5021.4
          },
          "moving_time": {
            "type": "number",
            "example": 1724
          },
          "total_elevation_gain": {
            "type": "number"
          },
          "sport_type": {
            "type": "string",
            "example": "Run"
          },
          "start_date_local": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-09T07:12:00Z"
          },
          "average_speed": {
            "type": "number"
          },
          "average_heartrate": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "distance",
          "moving_time",
          "total_elevation_gain",
          "sport_type",
          "start_date_local",
          "average_speed",
          "average_heartrate"
        ]
      },
      "RunStreams": {
        "type": "object",
        "properties": {
          "latlng": {
            "type": "object",
            "properties": {
              "data": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                }
              }
            },
            "required": [
              "data"
            ]
          },
          "time": {
            "$ref": "#/components/schemas/NumberStream"
          },
          "distance": {
            "$ref": "#/components/schemas/NumberStream"
          },
          "altitude": {
            "$ref": "#/components/schemas/NumberStream"
          },
          "heartrate": {
            "$ref": "#/components/schemas/NumberStream"
          },
          "velocity_smooth": {
            "$ref": "#/components/schemas/NumberStream"
          }
        }
      },
      "NumberStream": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "data"
        ]
      },
      "RunRenderState": {
        "type": "object",
        "properties": {
          "render": {
            "$ref": "#/components/schemas/RunRender"
          }
        },
        "required": [
          "render"
        ]
      },
      "RunRender": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "activity_id": {
            "type": "integer",
            "example": 987654321
          },
          "status": {
            "type": "string",
            "enum": [
              "rendering",
              "done",
              "error"
            ],
            "example": "rendering"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "example": 0.42
          },
          "output_url": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://remotionlambda-useast1-abcdef.s3.us-east-1.amazonaws.com/renders/abc/out.mp4"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "activity_id",
          "status",
          "progress",
          "output_url",
          "error",
          "created_at",
          "updated_at"
        ]
      },
      "CoachThread": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "8f2c1e34-9a1b-4f6d-8f0e-3b6a1c9d2e77"
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "example": "Half marathon in October"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ]
      },
      "CoachThreadDetail": {
        "type": "object",
        "properties": {
          "thread": {
            "$ref": "#/components/schemas/CoachThread"
          },
          "messages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CoachMessage"
            }
          }
        },
        "required": [
          "thread",
          "messages"
        ]
      },
      "CoachMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "example": "text"
                }
              },
              "required": [
                "type"
              ],
              "additionalProperties": {}
            }
          }
        },
        "required": [
          "id",
          "role",
          "parts"
        ]
      },
      "CoachChatRequest": {
        "type": "object",
        "properties": {
          "thread_id": {
            "type": "string",
            "example": "8f2c1e34-9a1b-4f6d-8f0e-3b6a1c9d2e77"
          },
          "trigger": {
            "type": "string",
            "enum": [
              "submit-message",
              "regenerate-message"
            ],
            "default": "submit-message"
          },
          "message": {
            "$ref": "#/components/schemas/CoachMessage"
          },
          "message_id": {
            "type": "string"
          }
        },
        "required": [
          "thread_id"
        ]
      },
      "ClientLogAccepted": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "example": 3
          }
        },
        "required": [
          "accepted"
        ]
      },
      "ClientLogBatch": {
        "type": "object",
        "properties": {
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientLogEvent"
            },
            "minItems": 1,
            "maxItems": 50
          }
        },
        "required": [
          "events"
        ]
      },
      "ClientLogEvent": {
        "type": "object",
        "properties": {
          "level": {
            "type": "string",
            "enum": [
              "debug",
              "info",
              "warn",
              "error"
            ],
            "example": "info"
          },
          "event": {
            "type": "string",
            "maxLength": 48,
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
            "example": "ui.render_clicked"
          },
          "message": {
            "type": "string",
            "maxLength": 500
          },
          "path": {
            "type": "string",
            "maxLength": 200
          },
          "context": {
            "$ref": "#/components/schemas/ClientLogContext"
          },
          "ts": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "level",
          "event"
        ]
      },
      "ClientLogContext": {
        "type": "object",
        "additionalProperties": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "example": {
          "activityId": 987654321,
          "status": 502
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Meta"
        ],
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "The API is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/strava": {
      "get": {
        "operationId": "getStravaAthlete",
        "tags": [
          "Athlete"
        ],
        "summary": "Get the signed-in athlete",
        "description": "Reads the session, takes the stored Strava access token (refreshing it when expired), and proxies GET /athlete from the Strava API.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The athlete's Strava profile.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Athlete"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Strava rejected or failed the upstream request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/runs": {
      "get": {
        "operationId": "getRuns",
        "tags": [
          "Runs"
        ],
        "summary": "List the signed-in athlete's runs",
        "description": "Proxies GET /athlete/activities from the Strava API and keeps only run-type activities (Run, TrailRun, VirtualRun).",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The athlete's runs, most recent first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Run"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "The stored Strava token lacks the activity:read scope; sign out and back in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Strava rejected or failed the upstream request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{id}/streams": {
      "get": {
        "operationId": "getRunStreams",
        "tags": [
          "Runs"
        ],
        "summary": "Get one run's GPS and sensor streams",
        "description": "Proxies GET /activities/{id}/streams from the Strava API. Activities without streams (e.g. manual entries) yield an empty object.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$",
              "example": "987654321"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The run's streams, keyed by type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStreams"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "The stored Strava token lacks the activity:read scope; sign out and back in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Strava rejected or failed the upstream request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{id}/render": {
      "get": {
        "operationId": "getRunRender",
        "tags": [
          "Runs"
        ],
        "summary": "Get one run's stored render",
        "description": "Reads the persisted render state for this run and athlete. `render` is null when the run has never been rendered. While a render is in flight, live progress comes from the SSE endpoint, which also keeps this state up to date.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$",
              "example": "987654321"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored render, or null if none exists.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunRenderState"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "startRunRender",
        "tags": [
          "Runs"
        ],
        "summary": "Render this run's video on Remotion Lambda",
        "description": "Fetches the run and its streams from Strava, starts a Remotion Lambda render of the story video, and persists the render state. The MP4 lands in the Remotion S3 bucket. Idempotent while a render is in flight or already done — those return the existing state; a failed render is retried.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$",
              "example": "987654321"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The render that is now in flight (or already finished).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunRenderState"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "The stored Strava token lacks the activity:read scope; sign out and back in.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "502": {
            "description": "Strava or Lambda failed the upstream request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Remotion Lambda is not configured on this server, or rendering is switched off for this athlete by the `video-render` feature flag.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/runs/{id}/render/progress": {
      "get": {
        "operationId": "streamRunRenderProgress",
        "tags": [
          "Runs"
        ],
        "summary": "Stream a render's progress (SSE)",
        "description": "Server-sent events. While the run's render is in flight, polls Remotion Lambda every ~1.5s, persists the result, and emits the updated RunRender as a JSON message. The final message has status `done` or `error`, after which the stream closes; a lone `null` message means there is no render. Consumed with EventSource, not the generated client.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^\\d+$",
              "example": "987654321"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "An event stream of RunRender JSON messages.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "503": {
            "description": "Remotion Lambda is not configured on this server.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/threads": {
      "get": {
        "operationId": "listCoachThreads",
        "tags": [
          "Coach"
        ],
        "summary": "List the athlete's coach conversations",
        "description": "Most recently used first. A thread with no messages has a null title.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "The athlete's conversations.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CoachThread"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createCoachThread",
        "tags": [
          "Coach"
        ],
        "summary": "Start a new coach conversation",
        "description": "Returns an empty thread. Its title is filled in from the first message the athlete sends to it.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "The new conversation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachThread"
                }
              }
            }
          },
          "401": {
            "description": "No valid session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/coach/threads/{id}": {
      "get": {
        "operationId": "getCoachThread",
        "tags": [
          "Coach"
        ],
        "summary": "Read one conversation",
        "description": "The thread and its full transcript, oldest message first.",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "8f2c1e34-9a1b-4f6d-8f0e-3b6a1c9d2e77"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The conversation and its messages.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoachThreadDetail"
