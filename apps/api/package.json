{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "webhook": "tsx scripts/strava-webhook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "auth:generate": "auth generate --config src/auth.ts --output .better-auth-schema.ts -y"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@posthog/ai": "^8.13.5",
    "@remotion/lambda": "4.0.534",
    "@repo/strava-api": "workspace:*",
    "@repo/video": "workspace:*",
    "ai": "^7.0.137",
    "better-auth": "1.7.7",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.2.0",
    "posthog-node": "^5.55.2",
    "tsx": "^4.23.15",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.26",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "auth": "1.7.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-seed": "^0.3.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
