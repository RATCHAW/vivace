{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "openapi:emit": "tsx scripts/emit-openapi.ts",
    "webhook": "tsx scripts/strava-webhook.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "auth:generate": "auth generate --config src/auth.ts --output .better-auth-schema.ts -y"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.0",
    "@posthog/ai": "^8.8.0",
    "@remotion/lambda": "4.0.512",
    "@repo/strava-api": "workspace:*",
    "@repo/video": "workspace:*",
    "ai": "^7.0.66",
    "better-auth": "1.6.29",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.2",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-loki": "^3.0.0",
    "pino-pretty": "^13.1.3",
    "posthog-node": "^5.49.1",
    "tsx": "^4.19.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^4.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "auth": "1.6.29",
    "drizzle-kit": "^0.31.10",
    "drizzle-seed": "^0.3.1",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
