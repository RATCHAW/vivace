# The app's origin. Every call to action on the landing page leaves for its
# /login route, so this points at apps/web — :5173 in dev, the real host in prod.
# NEXT_PUBLIC_* is inlined at build time, not read at runtime.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# Where the coach waitlist form sends its mail draft until there is an endpoint.
NEXT_PUBLIC_WAITLIST_EMAIL=hello@vivace.run
