# The app's origin. Product calls to action leave for apps/web — :5173 in dev,
# the real host in prod — either to sign in or to open a live feature.
# NEXT_PUBLIC_* is inlined at build time, not read at runtime.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# This page's own origin, for the canonical URL and the en/fr hreflang pair.
# Those tags must be absolute, so a wrong value here points search engines at
# the wrong host. Defaults to the final production host, https://www.vivace.run.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# PostHog, for traffic and conversion on this page. Leave empty and no
# analytics load at all. The project API key is public by design (it can only
# write events); the host is the region your project lives in.
NEXT_PUBLIC_POSTHOG_KEY=
# Where events are sent. Production points this at the reverse proxy on our own
# domain (https://cadence.vivace.run) so ad blockers don't drop the request —
# this page is the top of the funnel, so the visitors they drop are the ones
# worth counting. See the README. Locally, PostHog's own host is fine.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Where PostHog itself lives, for the toolbar and the "view recording" links.
# Only needs setting when the host above is a proxy hiding a non-US project.
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Stamped on every event as `environment`, so a local `next dev` can be told
# apart from the live page in the one project both write to. Defaults to
# NODE_ENV; set it only where that is wrong — a staging deploy is a production
# build.
NEXT_PUBLIC_APP_ENV=
