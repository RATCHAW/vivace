# Mapbox public access token (pk.*) from https://account.mapbox.com/access-tokens/
# Leave empty to render run videos on a plain route canvas instead of a map.
VITE_MAPBOX_TOKEN=

# PostHog — product analytics, session replay, error tracking and feature
# flags. Leave empty and none of it loads. The project API key is public by
# design (it can only write events); the host is your project's region.
VITE_POSTHOG_KEY=
# Where events are sent. Production points this at the reverse proxy on our own
# domain (https://cadence.vivace.run) so ad blockers don't drop the request —
# see the README. Locally, PostHog's own host is fine.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Where PostHog itself lives, for the toolbar and the "view recording" links.
# Only needs setting when the host above is a proxy hiding a non-US project.
VITE_POSTHOG_UI_HOST=https://us.posthog.com
# Stamped on every PostHog event and on the person, as `environment` — it is
# what tells the athletes you test with locally apart from the ones actually
# using the app, in the one project both write to. Defaults to Vite's mode
# (`development` under `pnpm dev`, `production` for a build), so set it only
# where that is wrong: a staging deploy is a production build.
VITE_APP_ENV=
# Thumbs up/down on the coach's answers, tied to the PostHog trace that wrote
# them. The id of an API-presentation survey whose first question is a 1–2
# rating scale — see the README. Empty and the thumbs aren't drawn.
VITE_POSTHOG_COACH_SURVEY_ID=

# The marketing site's origin — where the app's footer links out to for the
# about, privacy, terms, Strava data and contact pages. Inlined at build time,
# not read at runtime. Defaults to the production host.
VITE_SITE_URL=http://localhost:3001
