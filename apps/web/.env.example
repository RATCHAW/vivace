# Mapbox public access token (pk.*) from https://account.mapbox.com/access-tokens/
# Leave empty to render run videos on a plain route canvas instead of a map.
VITE_MAPBOX_TOKEN=

# PostHog — product analytics, session replay, error tracking and feature
# flags. Leave empty and none of it loads. The project API key is public by
# design (it can only write events); the host is your project's region.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
