{
  "name": "strava-login-app",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "prepare": "husky || true",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "pnpm --filter @repo/strava-api generate && pnpm --filter @repo/api openapi:emit && pnpm --filter @repo/web generate",
    "spec:pull": "pnpm --filter @repo/strava-api spec:pull",
    "video:deploy": "pnpm --filter @repo/video run deploy",
    "db:up": "docker compose up -d db",
    "db:generate": "pnpm --filter @repo/api run db:generate",
    "db:migrate": "pnpm --filter @repo/api run db:migrate",
    "db:studio": "pnpm --filter @repo/api run db:studio",
    "db:seed": "pnpm --filter @repo/api run db:seed",
    "db:reset": "docker compose down -v db && docker compose up -d db",
    "logs:up": "docker compose --profile observability up -d"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-turbo": "^2.10.9",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.67.0"
  }
}
