{
  "name": "strava-login-app",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "generate": "pnpm --filter @repo/strava-api generate && pnpm --filter @repo/api openapi:emit && pnpm --filter @repo/web generate",
    "spec:pull": "pnpm --filter @repo/strava-api spec:pull",
    "auth:migrate": "pnpm --filter @repo/api run auth:migrate",
    "db:up": "docker compose up -d db",
    "logs:up": "docker compose --profile observability up -d"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
