{
  "name": "strava-login-app",
  "private": true,
  "license": "CC-BY-NC-SA-4.0",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "generate": "pnpm --filter @repo/strava-api generate && pnpm --filter @repo/api openapi:emit && pnpm --filter @repo/web generate",
    "spec:pull": "pnpm --filter @repo/strava-api spec:pull",
    "auth:migrate": "pnpm --filter @repo/api run auth:migrate",
    "video:deploy": "pnpm --filter @repo/video run deploy",
    "db:up": "docker compose up -d db",
    "logs:up": "docker compose --profile observability up -d"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.5.0"
  }
}
