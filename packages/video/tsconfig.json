{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // For the `import "mapbox-gl/dist/mapbox-gl.css"` in RunMap — the same
    // ambient declarations apps/web relies on.
    "types": ["vite/client", "node"]
  },
  "include": ["src", "scripts"]
}
